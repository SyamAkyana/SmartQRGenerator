# SmartQR environment configuration
# Copy this file to `.env` and fill in real values. Never commit the real `.env`.

# PostgreSQL connection string (hosted provider, e.g. Aiven)
DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/defaultdb?sslmode=require

# Auth.js secret — generate with: `openssl rand -base64 32` (or `npx auth secret`)
AUTH_SECRET=

# Trust the host header (needed for local/non-Vercel deployments)
AUTH_TRUST_HOST=true

# Auth.js public base URL (must match APP_URL)
AUTH_URL=http://localhost:3000

# Public base URL of the application
APP_URL=http://localhost:3000

# Storage configuration
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./storage
MAX_FILE_SIZE_MB=10

# Analytics
ANALYTICS_ENABLED=true